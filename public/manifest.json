{
  "manifest_version": 3,
  "name": "Productive Pause",
  "version": "2.0.0",
  "description": "Pomodoro timer: 25 min work, 5 min break. Track focus sessions and stay productive.",
  "permissions": ["alarms", "notifications", "storage"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "start-timer": {
      "suggested_key": { "default": "Ctrl+Shift+P", "mac": "Command+Shift+P" },
      "description": "Start/Pause timer"
    }
  }
}
